# Prefer per-environment profiles instead of editing this file directly:
#   Backend/.env.local  Backend/.env.uat  Backend/.env.prod
# Switch with: bash scripts/switch-app-env.sh local|uat|prod
APP_TYPE=local
APP_ENV=dev

# Canonical secrets (MASTER_CURSOR_PROMPT.md §7.3):
SHOPIFY_API_SECRET=
SHOPIFY_API_KEY=
INTERNAL_HANDOFF_SECRET=change-me-handoff
TOKEN_ENCRYPTION_KEY=change-me-encryption

# Legacy placeholders (fallback only)
APP_SECRET=change-me
APP_SECRET_KEY=change-me

# Shop domain used by scripts/refresh-shopify-dev-token.py (client credentials)
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com

# CORS: frontend origins (local Vite + ngrok frontend URL)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

HOST=0.0.0.0
PORT=8080

# --- Database ---
# Prefer PostgreSQL in real environments. SQLite is a local/dev fallback for tests.
DATABASE_URL=sqlite+pysqlite:///./storage/app.db
# DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/aone_image_enhancement
# AWS UAT RDS: .../cms_uat   AWS prod RDS: .../cms

# --- POC mode switches and limits ---
POC_ENABLED=true
POC_MAX_PROMPT_STEPS=5
POC_MAX_IMAGE_SIZE_MB=10
POC_STORAGE_DIR=storage/poc-jobs
POC_JOB_TTL_HOURS=24

# --- OpenAI image processing ---
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
OPENAI_TEXT_MODEL=gpt-4.1
# Phase 1: OPEN_AI (current OpenAI Batch/sync). Phase 2: external_llm (microservice - not implemented yet).
AI_PROVIDER=OPEN_AI
# AI_PROVIDER=external_llm
LLM_SERVICE_URL=
# Primary Queue production path (POC/preview remains SYNC in code)
AI_EXECUTION_MODE=OPENAI_BATCH
OPENAI_BATCH_ENABLED=true
# Emergency only - never silent in production
OPENAI_ALLOW_SYNC_FALLBACK=false
OPENAI_BATCH_COMPLETION_WINDOW=24h
OPENAI_BATCH_POLL_INTERVAL_SECONDS=20
OPENAI_TEMP_FILE_RETENTION_HOURS=48
OPENAI_IMAGE_TIMEOUT_SECONDS=180

# Dev only: allow POC/queue API without App Bridge JWT (local browser testing)
POC_DEV_SKIP_AUTH=true

# --- Processing queue (Postgres-backed; asyncio worker - no Celery in this phase) ---
AUTO_PROCESSING_ENABLED=true
PROCESSING_BATCH_SIZE=10
PROCESSING_BATCH_CONCURRENCY=2
PROCESSING_POLL_INTERVAL_SECONDS=5
PROCESSING_MAX_ATTEMPTS=3
PROCESSING_RETRY_DELAY_SECONDS=60
PROCESSING_ITEM_TIMEOUT_SECONDS=300
PROCESSING_STALE_LOCK_SECONDS=600
PROCESSING_WORKER_ID=
PROCESSING_OUTPUT_DIRECTORY=storage/processed

SHOPIFY_IMAGE_DOWNLOAD_TIMEOUT_SECONDS=60
SHOPIFY_IMAGE_MAX_DOWNLOAD_MB=30
SHOPIFY_API_VERSION=2026-07
# Dev-only Admin API token fallback when shops.encrypted_access_token is empty (APP_ENV=dev only)
# Auto-refreshed by scripts/dev-all.sh via client credentials when SHOPIFY_SHOP_DOMAIN + API key/secret are set
SHOPIFY_DEV_ACCESS_TOKEN=

# --- Generated image validation / CDN version temp retention ---
SHOPIFY_IMAGE_PREFERRED_MAX_MB=10
SHOPIFY_IMAGE_OPTIMIZE_WARN_MB=10
SHOPIFY_IMAGE_OPTIMIZE_ATTEMPT_MB=15
SHOPIFY_IMAGE_REJECT_MB=20
PROCESSING_TEMP_RETRY_RETENTION_HOURS=48
IMAGE_STORAGE_WARN_TOTAL_VERSIONS=5000
IMAGE_STORAGE_WARN_AVG_GENERATED_MB=8
IMAGE_STORAGE_WARN_VERSIONS_PER_PRODUCT=50

# --- Week 2 Auto Sync server caps ---
BATCH_INTERVAL_MINUTES_CAP=1440
DEFAULT_BATCH_INTERVAL_MINUTES=15
AUTO_BATCH_CLAIM_LIMIT=500
AUTO_BATCH_PRODUCT_LIMIT=10
MANUAL_BATCH_PRODUCT_LIMIT=2

# --- Local rembg cut-out (after OpenAI, before Shopify upload) ---
# Free / no extra OpenAI Batch step. u2netp is the small model for ~1 GB UAT RAM.
REMBG_ENABLED=true
REMBG_MODEL=u2netp
REMBG_REQUIRE_ALPHA=true